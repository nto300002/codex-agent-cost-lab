{
  "name": "trace-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:customer": "vitest run --config vitest.feature.config.ts --passWithNoTests customer",
    "test:deal": "vitest run --config vitest.feature.config.ts --passWithNoTests deal",
    "test:activity": "vitest run --config vitest.feature.config.ts --passWithNoTests activity",
    "test:auth": "vitest run --config vitest.feature.config.ts --passWithNoTests auth",
    "test:audit": "vitest run --config vitest.feature.config.ts --passWithNoTests audit",
    "experiment:verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:e2e && pnpm build",
    "experiment:check-forbidden-changes": "tsx scripts/check-forbidden-changes.ts",
    "experiment:record-baseline": "tsx scripts/verify-baseline.ts --record",
    "experiment:validate-tasks": "tsx scripts/validate-task-definitions.ts",
    "experiment:verify-task-assets": "tsx scripts/verify-task-assets.ts --execute",
    "experiment:verify-baseline": "pnpm experiment:verify && tsx scripts/verify-baseline.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:ensure": "tsx scripts/ensure-database-file.ts",
    "db:generate": "prisma generate",
    "db:reset": "pnpm db:ensure && prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
